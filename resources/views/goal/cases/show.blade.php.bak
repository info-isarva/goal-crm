@push('scripts')
<script>
(function () {
    var page = document.getElementById('cwPage');
    if (!page) return;
    var tabInput = document.getElementById('cw_tab');

    function activateTab(key) {
        page.querySelectorAll('.cw-tab').forEach(function (btn) {
            btn.classList.toggle('active', btn.getAttribute('data-cw-tab') === key);
        });
        page.querySelectorAll('.cw-pane').forEach(function (pane) {
            pane.classList.toggle('active', pane.getAttribute('data-pane') === key);
        });
        if (tabInput) tabInput.value = key;
        page.setAttribute('data-active-tab', key);
        try { history.replaceState(null, '', '?tab=' + encodeURIComponent(key)); } catch (e) {}
    }

    page.querySelectorAll('.cw-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
            activateTab(btn.getAttribute('data-cw-tab'));
        });
    });

    // Sync hidden identity fields from applicant inputs before workspace save
    var wsForm = document.getElementById('cwWorkspaceForm');
    if (wsForm) {
        wsForm.addEventListener('submit', function () {
            var nameEl = wsForm.querySelector('[name="customer_details[applicant][name]"]');
            var mobEl = wsForm.querySelector('[name="customer_details[applicant][mobile]"]');
            var hiddenName = document.getElementById('cw_customer_name');
            var hiddenMob = document.getElementById('cw_mobile');
            if (nameEl && hiddenName && nameEl.value) hiddenName.value = nameEl.value;
            if (mobEl && hiddenMob && mobEl.value) hiddenMob.value = mobEl.value;
        });
    }

    page.querySelectorAll('.js-mobile').forEach(function (el) {
        el.addEventListener('input', function () {
            el.value = String(el.value || '').replace(/\D+/g, '').slice(0, 10);
        });
    });

    page.querySelectorAll('.js-doc-status').forEach(function (sel) {
        var sync = function () {
            var id = sel.getAttribute('data-reason-target');
            var reason = id ? document.getElementById(id) : null;
            if (!reason) return;
            if (sel.value === 'Rejected') {
                reason.setAttribute('required', 'required');
            } else {
                reason.removeAttribute('required');
            }
        };
        sel.addEventListener('change', sync);
        sync();
    });

    // Transition conditional fields
    var toSel = document.getElementById('cwToStatus');
    function syncTransitionFields() {
        var to = toSel ? toSel.value : '';
        var q = document.getElementById('cwQueryFields');
        var s = document.getElementById('cwSancFields');
        var d = document.getElementById('cwDisbFields');
        var lenderReq = document.querySelectorAll('.cw-req-lender');
        if (q) q.classList.toggle('d-none', to !== 'Bank Query');
        if (s) s.classList.toggle('d-none', to !== 'Sanctioned');
        if (d) d.classList.toggle('d-none', to !== 'Disbursed');
        lenderReq.forEach(function (el) {
            el.classList.toggle('d-none', to !== 'Bank Login');
        });
        var lender = document.getElementById('cwLender');
        if (lender) {
            if (to === 'Bank Login') lender.setAttribute('required', 'required');
            else lender.removeAttribute('required');
        }
        var qt = document.getElementById('cwQueryText');
        var qd = document.getElementById('cwQueryDue');
        if (qt && qd) {
            if (to === 'Bank Query') { qt.setAttribute('required', 'required'); qd.setAttribute('required', 'required'); }
            else { qt.removeAttribute('required'); qd.removeAttribute('required'); }
        }
        var sa = document.getElementById('cwSancAmt');
        var sd = document.getElementById('cwSancDate');
        if (sa && sd) {
            if (to === 'Sanctioned') { sa.setAttribute('required', 'required'); sd.setAttribute('required', 'required'); }
            else { sa.removeAttribute('required'); sd.removeAttribute('required'); }
        }
        var da = document.getElementById('cwDisbAmt');
        var dd = document.getElementById('cwDisbDate');
        var dr = document.getElementById('cwDisbRef');
        if (da && dd && dr) {
            if (to === 'Disbursed') {
                da.setAttribute('required', 'required');
                dd.setAttribute('required', 'required');
                dr.setAttribute('required', 'required');
            } else {
                da.removeAttribute('required');
                dd.removeAttribute('required');
                dr.removeAttribute('required');
            }
        }
        var rr = document.getElementById('cwRejectReason');
        if (rr) {
            if (to === 'Rejected') rr.setAttribute('required', 'required');
            else rr.removeAttribute('required');
        }
    }
    if (toSel) {
        toSel.addEventListener('change', syncTransitionFields);
        syncTransitionFields();
    }

    if (window.IsarvaDatepicker) {
        window.IsarvaDatepicker.init(page);
    }

    activateTab(page.getAttribute('data-active-tab') || 'customer');
})();
</script>
@endpush
